# macOS Finder metadata. These were tracked once and shipped inside the CRX.
.DS_Store

# Store upload packages. Built from the tracked sources by zipping manifest.json,
# popup.html, icons/ and src/, so committing them stores a second copy of the
# whole extension per release — and a stale one, since the zip is usually rebuilt
# after the commit that carries it.
darkboard-*.zip

# Scratch copies for the ?impl= / ?css= before-and-after comparisons described
# in test/README.md. Always derived from git, never meant to be committed.
test/.tmp-*
